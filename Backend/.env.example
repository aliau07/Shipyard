# Copy to Backend/.env and adjust. Never commit the real .env file.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Development defaults. In production set DEBUG=False and list your real host names.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Production over HTTPS only (ignored when DEBUG=True):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Browser origins allowed to call the API (the React app).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The React app's address, used in links inside notification emails.
FRONTEND_URL=http://localhost:3000

# Leave unset to use SQLite (Backend/db.sqlite3). For PostgreSQL:
# DATABASE_URL=postgres://shipyard:shipyard-password@localhost:5432/shipyard

# Emails print to the console by default (recommended for local use). For real email:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Shipyard <noreply@example.com>

# Optional API rate limits (DRF throttle rate syntax).
# THROTTLE_RATE_ANON=60/minute
# THROTTLE_RATE_USER=600/minute
# THROTTLE_RATE_LOGIN=10/minute

# Where uploaded comment screenshots are stored (defaults to Backend/media).
# MEDIA_ROOT=/var/lib/shipyard/media

# seed_demo_data generates fresh passwords on every run; set this to use one fixed password instead.
# DEMO_PASSWORD=
